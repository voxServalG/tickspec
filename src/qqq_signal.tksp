# ============================================================================
# tickspec 信号文件 — 教学示例
# ============================================================================
#
# 文件格式：.tksp
# 文件类型：signal（信号）
#
# 信号文件的职责：
#   消费外部因子库提供的原始因子，产出 [-1, 1] 的标量信号值。
#   -1 表示极端看空，0 表示中性，+1 表示极端看多。
#
# ============================================================================
# 元数据头（必填，以 # key: value 格式书写）
# ============================================================================
# language: tickspec
# kind: signal                      # 文件种类：signal（信号）或 strategy（策略）
# name: qqq_signal

# ============================================================================
# 因子（Factor）类型系统
# ============================================================================
# 本语言不计算因子数值。因子由外部因子库计算并提供，信号文件只声明"消费哪些因子"。
#
# 因子分四种类型，注释在输入名后面：
#   number   — 浮点数，如 0.05、-1.2
#   bool     — 布尔值，true / false
#   enum     — 枚举，如 [breakout, pullback, range, breakdown]
#   ordinal  — 有序分类，如 [low, medium, high, extreme]
#
# enum 与 ordinal 的区别：
#   enum  的各值之间无顺序关系，只能做 == / != 比较。
#   ordinal 的各值之间有顺序（low < medium < high < extreme），可做大小比较。
# ============================================================================

# ============================================================================
# inputs — 因子声明
# ============================================================================
# 列出本信号依赖的所有外部因子。
# 这些因子由外部因子库提供，此处只声明不计算。
# 类型以行内注释标注，便于阅读和校验。
# ============================================================================
inputs:
  - qqq_drawdown_3mo #number      QQQ 近3个月最大回撤（小数，如 0.12 = 12%）
  - qqq_return_1d    #number      QQQ 最近1日收益率（小数，如 -0.03 = -3%）

# ============================================================================
# output — 输出声明
# ============================================================================
# 声明本信号最终输出值的合法范围。
# 无论内部计算如何，最终结果都会被 clamp 到 [min, max] 区间内。
# 信号语义：-1 = 极端看空，0 = 中性，+1 = 极端看多。
# ============================================================================
output:
  o: [-1,1]

# ============================================================================
# scheduled_checks — 定时检查
# ============================================================================
# 按固定周期（every）定期执行。
#
# 规则：
#   1. every 指定执行频率：1d=每日, 1h=每小时, 1w=每周 等（枚举值）。
#   2. emit 是一组 [条件, 输出值] 的列表。
#   3. 同一 name 内的所有 emit 条件必须互斥——每次执行恰好命中一条（类似 if/else if/else）。
#   4. 条件（bool 表达式）只能引用 inputs 中声明的因子，使用比较和逻辑运算符。
#   5. 输出值只能是数字字面量，不能是表达式。
#
# 执行语义：
#   每逢 every 指定的时刻，评估 emit 中所有条件，找到为 true 的那一条，
#   将其对应的输出值作为本信号当前值。
# ============================================================================
scheduled_checks:
  - name: daily_check               # 规则名称（可任意命名）
    every: 1d                       # 每天执行一次（1d = 1 day）
    emit:
      # 格式：[条件(bool), 输出值(number)]
      # 以下5条条件覆盖了 qqq_drawdown_3mo 的全部取值范围，互斥且完备：
      - [qqq_drawdown_3mo < 0.05, 0.0]                                    # 回撤<5%：无恐慌，信号中性
      - [qqq_drawdown_3mo >= 0.05 and qqq_drawdown_3mo < 0.10, 0.3]       # 回撤5%~10%：轻度压力
      - [qqq_drawdown_3mo >= 0.10 and qqq_drawdown_3mo < 0.15, 0.7]       # 回撤10%~15%：中度压力
      - [qqq_drawdown_3mo >= 0.15, 1.0]                                   # 回撤>=15%：高度压力，信号满格

# ============================================================================
# triggers — 事件触发器（FPGA 风格）
# ============================================================================
# 持续监视因子，一旦条件满足立即触发，类似硬件中断。
#
# 与 scheduled_checks 的关键区别：
#   - scheduled_checks 是"到了时间就检查"，triggers 是"条件一成立就动作"。
#   - triggers 的输出覆盖（override）scheduled_checks 的输出。
#
# trigger 的两种条件类型：
#   1. Level Condition（电平事件）：
#      条件是一个普通的 bool 表达式（如 qqq_return_1d <= -0.03）。
#      只要条件持续为 true，就持续输出。
#      类比：电路中的高电平——只要电压高于阈值就一直亮灯。
#
#   2. Edge Condition（脉冲事件）：
#      条件使用 cross_over(value, threshold) 函数。
#      只在"穿越阈值"的那一瞬间触发一次，输出为单次脉冲。
#      语法：cross_over(信号, 阈值)——信号从下方向上穿越阈值时触发。
#      类比：示波器捕捉上升沿——只在波形穿过参考线的瞬间记录。
#      注意：脉冲事件不会持续输出，一次性触发后即结束。
#
# priority 规则：
#   - 必须填写，数字越小优先级越高（0 为最高）。
#   - 多个 trigger 同时触发时，只执行 priority 最小（最优先）的那个。
#   - 同 priority 的 active trigger 不允许同时触发（条件必须互斥）。
#   - 不同 priority 的 trigger 可以重叠，低 priority（数字更小）胜出。
# ============================================================================
triggers:
  # -------------------- 电平事件示例 --------------------
  # 含义：只要单日跌幅 ≥ 3%，就持续输出 0.8 的看空信号。
  # 这是持续性的——如果连跌三天，这三天都输出 0.8。
  - name: one_day_fast_drop
    when: qqq_return_1d <= -0.03    # 条件：单日跌幅 ≥ 3%
    emit:
      - [true, 0.8]                 # 条件为 true（进入触发器即命中），输出 0.8
    priority: 1                     # 优先级 1（数字越小越优先）

  # -------------------- 脉冲事件示例 --------------------
  # 含义：当回撤从 5% 以下首次突破 5% 时，触发一次脉冲输出 0.6。
  # 这是单次的——只在穿越瞬间触发，过后不再输出。
  - name: drawdown_cross_5
    when: cross_over(qqq_drawdown_3mo, 0.05)  # 边沿检测：回撤上穿 5% 阈值
    emit:
      - [true, 0.6]                           # 脉冲瞬间输出 0.6
    priority: 0                                # 最高优先级，优先于 any_day_fast_drop

# ============================================================================
# 执行流程总结（每个 tick）：
#   1. 从外部因子库获取 qqq_drawdown_3mo 和 qqq_return_1d 的当前值。
#   2. 如果到达 scheduled_checks 的执行时刻，评估 emit 产出基础信号值。
#   3. 评估所有 trigger 的 when 条件：
#      - 电平条件：检查是否持续成立。
#      - 脉冲条件：检查是否有边沿穿越。
#   4. 按 priority 仲裁：取最小 priority 的命中 trigger。
#   5. 如果有 trigger 命中，用 trigger 的输出覆盖 scheduled 的输出。
#   6. 将最终输出 clamp 到 [-1, 1] 并返回。
# ============================================================================
