# ============================================================================
# tickspec 策略文件 — 教学示例
# ============================================================================
#
# 文件格式：.tksp
# 文件类型：strategy（策略）
#
# 策略文件的职责：
#   组合多个信号的输出，通过加权公式合成综合得分（score），
#   再依据 score 产出最终的交易操作（operation）。
#
# 信号（signal） vs 策略（strategy）：
#   signal   产出 [-1,1] 的标量值（情绪倾向），不涉及具体交易动作。
#   strategy 组合信号、产出 operation（目标仓位 / 买卖动作 / 不动），是最终决策层。
#
# ============================================================================
# 元数据头（必填）
# ============================================================================
# language: tickspec
# kind: strategy                    # 文件种类：strategy
# name: qqq_strategy

# ============================================================================
# signals — 依赖的信号声明
# ============================================================================
# 列出本策略所依赖的所有信号。
# 每个信号名必须对应一个已定义的 signal 文件。
# 策略在组合时会先求值所有依赖信号，拿到各信号的当前输出值。
# ============================================================================
signals:
  - qqq_signal                      # QQQ 趋势信号（来自 qqq_signal.tksp）
  - rate_signal                     # 利率环境信号（来自 rate_signal.tksp）
  - liquidity_signal                # 流动性信号（来自 liquidity_signal.tksp）

# ============================================================================
# combine — 信号加权组合
# ============================================================================
# 将各信号的输出值按权重线性加权，再用 clamp 限制到指定区间。
#
# 语法：clamp(权重表达式, 下界, 上界)
#   权重表达式：w1*signal_1 + w2*signal_2 + ...
#   权重一般总和为 1.0（标准化），但非强制。
#   clamp 确保结果不超出 [下界, 上界]。
#
# score 是组合后的综合得分，用于后续 scheduled_checks 和 triggers 的条件判断。
# ============================================================================
combine:
  - score: clamp(0.7*qqq_signal + 0.2*rate_signal + 0.1*liquidity_signal, -1, 1)
    # 权重含义：QQQ 趋势占70%主导权重，利率环境占20%，流动性占10%

# ============================================================================
# scheduled_checks — 定时决策
# ============================================================================
#
# 与信号文件中的 scheduled_checks 结构相同，但 emit 的含义不同：
#   signal 的 emit：[条件, 信号值数值]
#   strategy 的 emit：[条件, operation]
#
# ============================================================================
# Operation（操作） — target / action / hold
# ============================================================================
# 每条 emit 的第二个元素是一个 operation，可选以下三种形态：
#
#   1. {target: {标的: 仓位比例, ...}}
#       — 调仓目标：将指定标的仓位调整到目标比例
#       — 示例：{target: {QQQ: 0.15}}  将 QQQ 仓位调至最大可持仓的 15%
#       — 支持多资产：{target: {QQQ: 0.1, SPY: 0.05}}
#
#   2. {action: {标的: {方向: 数量}, ...}}
#       — 具体动作：对指定标的执行买卖
#       — 示例：{action: {QQQ: {buy: 20}}}   买入 20 单位 QQQ
#                {action: {QQQ: {sell: 30}}}  卖出 30 单位 QQQ
#       — 方向只支持 buy / sell
#       — 支持多资产：{action: {QQQ: {buy: 10}, SPY: {sell: 5}}}
#       — 单位语义由执行层定义，本语言不关心是股数、金额还是百分比
#
#   3. hold
#       — 保持不动：所有标的全都不做任何调整
#       — hold 是"全局不操作"的显式声明
#
# ============================================================================
# Operation 共存与互斥规则
# ============================================================================
#
# target 与 action 可共存（用于不同标的）：
#   {target: {QQQ: 0.15}, action: {SPY: {buy: 20}}}
#   → 调整 QQQ 仓位到 15%，同时买入 20 单位 SPY
#   → 合法：QQQ 在 target 中，SPY 在 action 中，各自独立
#
# hold 与 target / action 互斥：
#   hold 表示"全局不操作"，不能与 target 或 action 共存。
#   {target: {QQQ: 0.15}, hold}  — 非法：不能同时又操作又不动
#
# 同标的约束：
#   - 同一支标的不允许同时出现在 target 和 action 中。
#     {target: {QQQ: 0.15}, action: {QQQ: {buy: 20}}}  — 非法：QQQ 冲突
#   - 同一支标的 action 不允许同时出现 buy 和 sell。
#     {action: {QQQ: {buy: 10, sell: 5}}}  — 非法：方向冲突
#   - 未在 target 或 action 中出现的标的，隐式 hold（不做调整）。
# ============================================================================
scheduled_checks:
  - name: daily_decision            # 每日决策
    every: 1d                       # 每天执行一次
    emit:
      # 格式：[条件(bool), operation]
      # target 与 action 可共存（不同标的），以下示例展示混合用法：
      # 以下5条条件覆盖 score 的 [-1, 1] 全范围，互斥且完备：
      - [score < -0.7, {target: {QQQ: 0.0}, action: {SPY: {sell: 20}}}]                                               # 强烈看空 → QQQ清仓 + 卖出SPY
      - [score >= -0.7 and score < -0.3, {target: {QQQ: 0.05}, action: {VIX: {buy: 5}}}]                              # 偏空 → QQQ减仓 + 买VIX对冲
      - [score >= -0.3 and score <= 0.3, hold]                                                                        # 中性 → 全局不动
      - [score > 0.3 and score <= 0.7, {target: {QQQ: 0.10}, action: {IWM: {buy: 15}}}]                               # 偏多 → QQQ加仓 + 买小盘股
      - [score > 0.7, {target: {QQQ: 0.15}, action: {TQQQ: {buy: 30}}}]                                               # 强烈看多 → 满仓QQQ + 杠杆追涨

# ============================================================================
# triggers — 事件触发（策略级）
# ============================================================================
#
# 与信号文件的 trigger 机制完全一致，但 emit 产出的是 operation。
# 策略级 trigger 用于捕捉极端行情或穿越信号，做快速响应。
#
# trigger 条件类型（与信号文件相同）：
#   电平事件：条件成立期间持续输出。
#   脉冲事件：只在穿越瞬间单次输出（cross_over）。
#
# priority 规则（策略级）：
#   - 数字越小越优先，最小值为 0。
#   - emit 内部条件必须互斥（同一 trigger 内只能命中一条 emit）。
#   - trigger 之间允许重叠（不同 trigger 可以同时触发）。
#   - 同 priority 的 active trigger 不允许重叠（同一时刻同一优先级的触发条件必须互斥）。
#   - 不同 priority 重叠时：priority 数字最小者胜出。
#   - trigger 输出覆盖 scheduled_checks 的输出。
#
# ============================================================================
triggers:

  # --------------------------------------------------------------------------
  # 电平事件 — priority 0（最高优先级）
  # 含义：当综合得分极端时，持续执行买卖动作，覆盖每日决策。
  # --------------------------------------------------------------------------

  # 极端恐慌：score ≤ -0.8 时持续卖出 50 单位
  - name: panic_sell
    when: score <= -0.8              # 条件：综合得分极端看空
    emit:
      - [true, {action: {QQQ: {sell: 50}}}]  # 动作：卖出 50 单位 QQQ
    priority: 0                      # 最高优先级

  # 急速拉升：score ≥ 0.8 时持续买入 30 单位
  # 与 panic_sell 同 priority 0，但条件互斥（score 不可能同时 ≤-0.8 且 ≥0.8），满足规则。
  - name: fast_rally
    when: score >= 0.8               # 条件：综合得分极端看多
    emit:
      - [true, {action: {QQQ: {buy: 30}}}]   # 动作：买入 30 单位 QQQ
    priority: 0                      # 最高优先级，与 panic_sell 互斥不冲突

  # --------------------------------------------------------------------------
  # 脉冲事件 — priority 1
  # 含义：当 score 穿越零轴时，做一次小额的跟随调仓。
  # 脉冲事件只在穿越瞬间触发一次，后续不再输出。
  # --------------------------------------------------------------------------

  # 下穿零轴：score 从正变负时，卖出 10 单位
  # cross_over(-score, 0.0) 等价于检测 score 从正数下降到负数的瞬间。
  - name: score_cross_down
    when: cross_over(-score, 0.0)    # 脉冲检测：score 从上方向下穿越 0
    emit:
      - [true, {action: {QQQ: {sell: 10}}}]  # 脉冲瞬间卖出 10 单位
    priority: 1                      # 优先级 1，低于 priority 0 的 trigger

  # 上穿零轴：score 从负变正时，买入 10 单位
  # cross_over(score, 0.0) 检测 score 从负数上升到正数的瞬间。
  # 与 score_cross_down 同 priority 1，但条件互斥（不可能同时上穿和下穿），满足规则。
  - name: score_cross_up
    when: cross_over(score, 0.0)     # 脉冲检测：score 从下方向上穿越 0
    emit:
      - [true, {action: {QQQ: {buy: 10}}}]   # 脉冲瞬间买入 10 单位
    priority: 1                      # 优先级 1，与 score_cross_down 互斥不冲突

# ============================================================================
# 执行流程总结（每个 tick）：
#   1. 求值所有依赖信号，得到 qqq_signal、rate_signal、liquidity_signal 的当前值。
#   2. 根据 combine 公式计算 score = clamp(0.7*q + 0.2*r + 0.1*l, -1, 1)。
#   3. 如果到达 scheduled_checks 的执行时刻，评估 emit 产出基础 operation。
#   4. 评估所有 trigger 的 when 条件：
#      - 电平条件：检查是否持续成立。
#      - 脉冲条件：检查是否有边沿穿越。
#   5. 按 priority 仲裁所有命中的 trigger，取 priority 最小者。
#   6. 如果有 trigger 命中，用 trigger 的 operation 覆盖 scheduled 的 operation。
#   7. 输出最终的 operation 给执行层。
#
# 层级互斥总览：
#   层级                    | 互斥约束
#   ------------------------+----------------------------------------------
#   emit 内部（条件）         | 同一 name 的 emit 条件必须互斥，每次只命中一条
#   operation 内部          | target/action 可共存（不同标的），hold 与二者互斥
#   同标的一支              | 同标的不允许 target+action 并存，不允许 buy+sell 并存
#   trigger 同 priority     | 同 priority 的 active trigger 条件必须互斥
#   trigger 不同 priority   | 允许重叠，数字更小（更优先）的胜出
#   trigger vs scheduled    | trigger 输出覆盖 scheduled 输出
# ============================================================================
